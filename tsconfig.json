{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "ES2020", "DOM", "DOM.Iterable" ],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": false
	},
	"include": [ "src/**/*" ]
}
