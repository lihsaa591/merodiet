{
	"name": "nutrio/nutrio",
	"description": "Practice management for registered dietitians and nutritionists — meal planning, client compliance tracking, and USDA-backed nutrient calculations.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/lihsaa591/nutrio",
	"keywords": [
		"dietitian",
		"nutritionist",
		"nutrition",
		"meal-planning",
		"client-management",
		"health",
		"usda",
		"wordpress",
		"wordpress-plugin",
		"php"
	],
	"support": {
		"issues": "https://github.com/lihsaa591/nutrio/issues",
		"source": "https://github.com/lihsaa591/nutrio"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": ">=8.1",
		"league/container": "^5.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^10",
		"brain/monkey": "^2.6",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"wp-coding-standards/wpcs": "^3.1",
		"phpstan/phpstan": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"Nutrio\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Nutrio\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"phpcs": "phpcs -s -p",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"test:coverage": "phpunit --coverage-html coverage"
	}
}
